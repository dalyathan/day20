# Day 20 - PayPal SANDBOX credentials (never commit the real .env)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=paste-client-id-here
PAYPAL_CLIENT_SECRET=

# Your own sandbox dispute, for the "Live sandbox case" switch and live-check. Leave it commented out to use
# the saved demo case (PP-R-UZH-10198816), which only the maintainer's keys can read live.
# DEMO_DISPUTE_ID=PP-R-...

# Optional: Log in with PayPal (also set this Return URL in the PayPal app settings)
PAYPAL_RETURN_URL=http://localhost:3000/auth/paypal/callback

# Optional: the AI model. Without it, Day 20 runs on rules alone.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: email fallback for reminders (resend.com)
RESEND_API_KEY=
EMAIL_FROM=

# Sessions (any long random string)
SESSION_SECRET=
